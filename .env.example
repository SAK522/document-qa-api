# Copy to `.env` for local development. `.env` is gitignored, so keys never reach GitHub.

# --- Database (local dev uses SQLite by default) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: keep this app's tables in their own schema so several apps can share one database.
# DATABASE_SCHEMA=docqa

# --- Auth ---
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-production

# --- AI providers -------------------------------------------------------------
# With nothing set below, the API runs fully offline:
#   hash embeddings + extractive answers (quotes the best sentence from the document).

# Answers from a real LLM: any OpenAI-compatible chat API.
# LLM_PROVIDER=openai
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://api.openai.com/v1           # OpenAI
# LLM_BASE_URL=https://api.groq.com/openai/v1      # Groq
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Google Gemini
# LLM_BASE_URL=http://localhost:11434/v1           # Ollama (local, free)
# LLM_MODEL=gpt-4o-mini                            # use a model name your provider offers

# Semantic embeddings: any OpenAI-compatible embeddings API.
# Re-upload documents after changing this (vectors from different models can't be compared).
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=   # defaults to LLM_BASE_URL
# EMBEDDINGS_API_KEY=    # defaults to LLM_API_KEY

# --- Tuning (optional) ---
# CHUNK_WORDS=180
# CHUNK_OVERLAP=40
# TOP_K=4
# MIN_SIMILARITY=0.08      # default: 0.08 for hash embeddings, 0.30 for API embeddings
# MAX_UPLOAD_MB=10
